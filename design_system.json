{
  "$schema": "./design_system.schema.json",
  "name": "ASR Collection Design System",
  "version": "1.0.0",
  "description": "ASR Collection storefront design system: design tokens, component contracts, responsive UI patterns, accessibility requirements, and implementation conventions.",
  "tokens": {
    "color": {
      "brand": {
        "primary": "#16803D",
        "primaryHover": "#126B33",
        "primaryActive": "#0F572A",
        "secondary": "#F15A24",
        "secondaryHover": "#D94B1B"
      },
      "surface": {
        "page": "#F7F8FA",
        "default": "#FFFFFF",
        "subtle": "#F1F5F2",
        "raised": "#FFFFFF",
        "inverse": "#142018"
      },
      "text": {
        "primary": "#17211A",
        "secondary": "#59665D",
        "muted": "#657167",
        "inverse": "#FFFFFF",
        "link": "#16803D"
      },
      "border": {
        "default": "#E1E7E2",
        "strong": "#C6D0C8",
        "focus": "#16803D"
      },
      "feedback": {
        "success": "#16803D",
        "warning": "#B45309",
        "danger": "#C62828",
        "info": "#2563EB"
      },
      "promo": {
        "background": "#FFF1EB",
        "text": "#B93815",
        "badge": "#E94F22"
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
      },
      "fontSize": {
        "xs": "12px",
        "sm": "14px",
        "md": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px"
      },
      "lineHeight": {
        "tight": 1.2,
        "normal": 1.5,
        "relaxed": 1.65
      },
      "fontWeight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      }
    },
    "spacing": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "xl": "20px",
      "full": "9999px"
    },
    "shadow": {
      "sm": "0 1px 2px rgba(16, 24, 16, 0.06)",
      "md": "0 4px 12px rgba(16, 24, 16, 0.08)",
      "lg": "0 12px 32px rgba(16, 24, 16, 0.12)"
    },
    "motion": {
      "durationFast": "120ms",
      "durationNormal": "200ms",
      "durationSlow": "300ms",
      "easingStandard": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "layout": {
      "contentMaxWidth": "1200px",
      "pageGutterMobile": "16px",
      "pageGutterDesktop": "24px",
      "sectionGapMobile": "24px",
      "sectionGapDesktop": "32px"
    }
  },
  "components": {
    "productCard": {
      "showBrand": false,
      "showPrice": true,
      "showSalePrice": true,
      "showDiscountBadge": true,
      "showRating": true,
      "showSoldCount": false,
      "showWishlist": true,
      "titleMaxLines": 2,
      "priceFontWeight": 700,
      "hoverEffectDesktop": "subtle-lift",
      "layout": "image-first",
      "imageAspectRatio": "4:5",
      "imageFit": "cover",
      "showQuickAdd": true,
      "showStockStatus": true,
      "loadingImage": "lazy",
      "focusVisible": true
    },
    "promoBanner": {
      "radius": "16px",
      "aspectRatio": "16:5",
      "mobileAspectRatio": "2:1",
      "imageAltRequired": true,
      "overlayContrastRequired": true,
      "ctaRequired": false
    },
    "button": {
      "heightSm": "36px",
      "heightMd": "44px",
      "heightLg": "48px",
      "radius": "10px",
      "primaryBackground": "{tokens.color.brand.primary}",
      "primaryText": "{tokens.color.text.inverse}",
      "minimumTouchTarget": "44px",
      "variants": [
        "primary",
        "secondary",
        "outline",
        "ghost",
        "destructive"
      ],
      "sizes": [
        "sm",
        "md",
        "lg",
        "icon"
      ],
      "disabledState": true,
      "loadingState": true,
      "focusVisible": true
    },
    "bottomNavigation": {
      "enabled": true,
      "mobileOnly": true,
      "height": "64px",
      "items": [
        {
          "id": "home",
          "label": "Beranda",
          "icon": "house"
        },
        {
          "id": "categories",
          "label": "Kategori",
          "icon": "grid-2x2"
        },
        {
          "id": "cart",
          "label": "Keranjang",
          "icon": "shopping-cart",
          "showBadge": true
        },
        {
          "id": "account",
          "label": "Akun",
          "icon": "user-round"
        }
      ],
      "safeAreaInset": true,
      "activeStateRequired": true,
      "ariaLabelRequired": true,
      "hideOnDesktop": true
    },
    "cartSummary": {
      "stickyOnMobile": true,
      "showItemCount": true,
      "showSubtotal": true,
      "primaryActionLabel": "Lanjut ke Checkout",
      "showShippingEstimate": true,
      "emptyStateRequired": true,
      "quantityControls": true,
      "subtotalExcludesShippingUntilCalculated": true
    },
    "checkout": {
      "layoutMobile": "single-column",
      "showOrderSummary": true,
      "showShippingCostStatus": true,
      "shippingCostPendingLabel": "Menunggu konfirmasi ongkir",
      "paymentActionLabel": "Lanjut ke Pembayaran",
      "states": [
        "idle",
        "validating",
        "submitting",
        "success",
        "error"
      ],
      "requireExplicitPaymentProviderIntegration": true,
      "neverMarkPaidFromClientOnly": true
    },
    "feedback": {
      "toastPositionMobile": "top-center",
      "emptyStateIllustration": "optional",
      "skeletonLoading": true,
      "toastLibrary": "sonner",
      "errorStateRequired": true,
      "successAndErrorMustIncludeText": true
    },
    "productDetail": {
      "imageGallery": true,
      "variantSelection": true,
      "quantitySelector": true,
      "stockStatus": true,
      "shippingInformation": true,
      "relatedProducts": true,
      "stickyAddToCartMobile": true
    },
    "search": {
      "autocompleteOptional": true,
      "clearAction": true,
      "emptyState": true,
      "keyboardAccessible": true
    },
    "form": {
      "labelRequired": true,
      "inlineValidation": true,
      "fieldErrorTextRequired": true,
      "autocompleteAttributesRequired": true
    },
    "dialog": {
      "focusTrap": true,
      "escapeToClose": true,
      "restoreFocus": true
    },
    "skeleton": {
      "ariaBusy": true,
      "reducedMotionCompatible": true
    }
  },
  "patterns": {
    "homeSections": [
      "SearchHeader",
      "PromoCarousel",
      "CategoryShortcuts",
      "FeaturedCollection",
      "NewArrivals",
      "RecommendedProducts",
      "TrustBenefits",
      "NewsletterOrFooter"
    ],
    "productDetail": [
      "Breadcrumbs",
      "ImageGallery",
      "ProductTitle",
      "PriceAndDiscount",
      "RatingAndReviewCount",
      "Availability",
      "VariantSelection",
      "QuantitySelector",
      "Description",
      "ShippingInformation",
      "RelatedProducts",
      "StickyAddToCart"
    ],
    "accessibility": {
      "minimumTouchTarget": "44px",
      "visibleFocusRing": true,
      "respectReducedMotion": true,
      "doNotUseColorAsOnlyStatusSignal": true,
      "imageAltTextRequired": true,
      "semanticLandmarksRequired": true,
      "keyboardNavigationRequired": true,
      "formLabelsRequired": true,
      "dialogFocusManagementRequired": true,
      "announceCartUpdates": true,
      "contrastTarget": "WCAG 2.2 AA",
      "reducedMotionMediaQuery": "prefers-reduced-motion"
    },
    "cart": [
      "CartItems",
      "QuantityControls",
      "RemoveItem",
      "OrderSummary",
      "ShippingEstimate",
      "EmptyCartState",
      "CheckoutCallToAction"
    ],
    "checkout": [
      "ContactInformation",
      "ShippingAddress",
      "DeliveryMethod",
      "OrderSummary",
      "PaymentMethodIntegrationBoundary",
      "ValidationAndErrorStates",
      "OrderConfirmation"
    ]
  },
  "tailwindMapping": {
    "primary": "brand.primary",
    "secondary": "brand.secondary",
    "background": "surface.page",
    "foreground": "text.primary",
    "card": "surface.default",
    "border": "border.default",
    "destructive": "feedback.danger",
    "ring": "border.focus",
    "brand": "color.brand.primary",
    "brandHover": "color.brand.primaryHover",
    "accent": "color.brand.secondary",
    "page": "color.surface.page",
    "surface": "color.surface.default",
    "mutedSurface": "color.surface.subtle",
    "text": "color.text.primary",
    "mutedText": "color.text.secondary",
    "subtleText": "color.text.muted",
    "success": "color.feedback.success",
    "warning": "color.feedback.warning",
    "danger": "color.feedback.danger",
    "promoBackground": "color.promo.background",
    "promoText": "color.promo.text",
    "radiusSm": "radius.sm",
    "radiusMd": "radius.md",
    "radiusLg": "radius.lg",
    "radiusXl": "radius.xl",
    "shadowSm": "shadow.sm",
    "shadowMd": "shadow.md",
    "shadowLg": "shadow.lg"
  },
  "implementationNotes": [
    "Warna hijau adalah aksen utama yang terinspirasi secara umum oleh marketplace Indonesia; oranye-merah menjadi aksen promosi sekunder.",
    "Jangan menggunakan logo, ikon bermerek, copy, atau aset proprietary Tokopedia/Shopee.",
    "Pastikan warna dan token diuji terhadap kontras WCAG sebelum produksi.",
    "Mapping token ke konfigurasi Tailwind perlu disesuaikan dengan versi Tailwind proyek.",
    "Nilai token dalam format {tokens...} adalah referensi desain; implementasi harus menyelesaikannya sebelum digunakan di CSS.",
    "This file is the design-system configuration; its validation contract lives in ./design_system.schema.json.",
    "Token references use dot notation and must be resolved by the token-to-CSS build step; raw reference strings must never be emitted as CSS values.",
    "The storefront uses React + TypeScript + Vite + Tailwind CSS v4 and accessible local UI components compatible with shadcn/ui conventions.",
    "Use mock product data only until a real catalog API is connected. Cart state is client-side demo state and is not persisted server-side.",
    "Checkout is a UI demonstration only. Do not initiate or simulate successful payment without an approved payment-provider integration and verified server-side status."
  ],
  "libraries": {
    "runtime": [
      "react",
      "react-dom",
      "react-router-dom"
    ],
    "styling": [
      "tailwindcss@4",
      "@tailwindcss/vite"
    ],
    "uiPrimitives": [
      "@radix-ui/react-slot"
    ],
    "components": [
      "class-variance-authority",
      "clsx",
      "tailwind-merge"
    ],
    "icons": [
      "lucide-react"
    ],
    "state": [
      "zustand"
    ],
    "feedback": [
      "sonner"
    ],
    "carousel": [
      "embla-carousel-react"
    ],
    "policy": "Use shadcn/ui-compatible local components built on Radix UI. Add components selectively; do not introduce a large UI framework that conflicts with the design tokens."
  }
}
